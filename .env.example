PORT=3000
# Local SQLite database. Optional absolute path.
# DB_PATH=./data/pos.sqlite
# Production behind a TLS reverse proxy only:
# HTTPS_ONLY=1
# TRUST_PROXY=1

# Production database (required outside automated tests)
# DATABASE_URL=postgresql://baan:change-me@localhost:5432/baan_pos
# PG_TENANT_ID=00000000-0000-0000-0000-000000000000

# Payment stays in demo mode until a provider adapter is configured
PAYMENT_MODE=simulation
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
