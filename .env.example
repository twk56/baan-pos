PORT=3000
# Local SQLite database. Optional absolute path.
# DB_PATH=./data/pos.sqlite
# Production behind a TLS reverse proxy only:
# HTTPS_ONLY=1
# TRUST_PROXY=1

# Production database (required outside automated tests)
# DATABASE_URL=postgresql://baan:change-me@localhost:5432/baan_pos
# PG_TENANT_ID=00000000-0000-0000-0000-000000000000

# Payment stays in demo mode until a provider adapter is configured
PAYMENT_MODE=simulation
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Opn Payments (enable only after provider review)
# PAYMENT_PROVIDER=opn
# OPN_SECRET_KEY=skey_test_...

# Encrypted PostgreSQL backup and optional S3-compatible off-site upload
# BACKUP_ENCRYPTION_KEY=use-a-long-random-secret
# S3_BUCKET=baan-pos-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_ENDPOINT_URL=https://s3.example.com
